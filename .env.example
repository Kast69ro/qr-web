# Адрес бэка. Браузер ходит на него напрямую, поэтому бэк должен отдавать
# CORS-заголовки для адреса, с которого открыт сайт.
# Без слеша в конце. Не задан — приложение покажет «не задан адрес сервера».
#
# dev:  уже задан в .env (тестовый сервер банка);
#       свой адрес — в .env.local (не попадает в git).
# прод: VITE_API_BASE_URL=https://... npm run build  (или .env.production) —
#       иначе в сборку попадёт тестовый адрес из .env.
VITE_API_BASE_URL=http://10.64.20.101:8888
