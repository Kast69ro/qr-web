# Адрес бэка для запросов из браузера. Пусто (по умолчанию) — тот же origin,
# запросы /pos проксирует Vite (dev/preview) или nginx (прод).
# Задавайте, только если бэк на отдельном домене и отдаёт CORS-заголовки.
VITE_API_BASE_URL=

# Куда Vite проксирует /pos в dev/preview (по умолчанию — тестовый сервер банка).
API_PROXY_TARGET=http://10.64.20.101:8888
